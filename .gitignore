# Local working files (drafts and internal notes). Not part of the repository.
local/

# Compiled encoders (regenerate: scripts/build_scripts/build106.sh)
best*
*.o
*.so

# Regenerable stream dumps, written to the CWD the encoder runs in
mem_*.bin
mm_*.bin
orig2uid.bin
pos_abs.bin
pos_strand.bin
read_lengths.bin
n_indices.bin
n_pos.bin
n_cnt.bin
n_reads.txt
literal.txt
literal.2bit
perm.u32
pg_full.txt

# Data and archives -- never committed
*.fq
*.fastq
*.fa
*.arc
*.arcs
*.spring
*.genozip
*.log
out.arcs2
*.arcs2

# Benchmark run outputs: archives (hundreds of MB), decoded reads, competitor
# archives and scratch. GitHub rejects files over 100 MB. The CSVs are kept in
# the repository, not the artefacts themselves.
results/sanity_*/
results/benchmark_1_*/
*.capsule
*.spring
*.genozip
bin/

# Regenerable caller output (can exceed GitHub's 100 MB file limit).
out.vcf
*.vcf

# Preserved raw evidence for reproduction audits. The *.log rule above would
# otherwise exclude these small evidence logs.
!benchmark/documentation/*_reproduction_*/*.log
# Same for the small truth and evidence VCFs kept alongside them.
!benchmark/documentation/*_reproduction_*/*.vcf

# Working history, paper drafts, and internal notes -- kept on this machine
# only, never pushed. The root of this repo is the clean, code+results+docs
# view; everything else this project produced during development lives here.
local/

# Compiled encoders (regenerate: scripts/build106.sh)
best*
*.o
*.so

# Regenerable stream dumps, written to the CWD the encoder runs in
mem_*.bin
mm_*.bin
orig2uid.bin
pos_abs.bin
pos_strand.bin
read_lengths.bin
n_indices.bin
n_pos.bin
n_cnt.bin
n_reads.txt
literal.txt
literal.2bit
perm.u32
pg_full.txt

# Data and archives -- never committed
*.fq
*.fastq
*.fa
*.arc
*.arcs
*.spring
*.genozip
*.log
out.arcs2
*.arcs2

# Benchmark run outputs: archives (hundreds of MB), decoded reads, competitor
# archives and scratch. GitHub rejects blobs over 100 MB, and a 547 MB .capsule
# from one sanity run got swept in by `git add -A` and hard-rejected the push.
# The CSVs and logs are what belong in the repo, not the artefacts themselves.
results/sanity_*/
results/benchmark_1_*/
*.capsule
*.spring
*.genozip
bin/

# 154 MB regenerable caller output; swept in by a git add -A on 2026-09-08
# and it made the whole branch unpushable (GitHub caps files at 100 MB).
out.vcf
*.vcf

# Preserved raw evidence for reproduction audits. The blanket *.log rule above
# would silently exclude these, leaving a README that cites logs nobody else
# can see -- caught 2026-09-10 when exactly that happened to the T2.4 and T3.4
# audit directories. These are small, they ARE the evidence, and they are the
# one class of .log this repository must keep.
!benchmark/documentation/*_reproduction_*/*.log
# Same reasoning for the small truth/evidence VCFs preserved alongside them:
# the blanket *.vcf rule would exclude the very file a correction cites as
# proof of what the original experiment actually measured.
!benchmark/documentation/*_reproduction_*/*.vcf
